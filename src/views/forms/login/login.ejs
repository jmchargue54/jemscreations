<%- include('../../partials/header') %>

    <h1><%= title %></h1>
    <p>
        Enter your email and password to access your account. Don't have an account? <a href="/register">Register here</a>.
        <br> If you just registered, it may take a few moments for your account to be activated.
    </p>
    
    <!-- TODO: Create form that posts to /login -->
     <form method="POST" action="/login" class="login-form">
        <!-- Email field -->
        <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" placeholder="Enter you email address" pattern="[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}" required>
        </div>
        <!-- Password field -->
        <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" placeholder="Enter your password" minlength="8" pattern="(?=.*[0-9])(?=.*[!@#$%^&*]).*" required>
        </div>
        <button type="submit">Login</button>
     </form>

<%- include('../../partials/footer') %>