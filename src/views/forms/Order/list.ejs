<%- include('../../partials/header') %>

<div class="container">
    <h1>All Orders</h1>

    <table>
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Date</th>
                <th>Customer</th>
                <th>Email</th>
                <th>Address</th>
                <th>Total</th>
                <th>Status</th>
                <th>Items</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            <% orders.forEach(order => { %>
                <tr>
                    <td><%= order.id %></td>
                    <td><%= order.created_at %></td>
                    
                    <td><%= order.first_name %> <%= order.last_name %></td>
                    <td><%= order.email %></td>
                    
                    <td>
                        <%= order.address %><br>
                        <%= order.city %>, <%= order.state %> <%= order.zip %><br>
                        <%= order.country %>
                    </td>

                    <td>$<%= order.total %></td>
                    <td><%= order.status %></td>

                    <td>
                        <ul>
                        <% order.items.forEach(item => { %>
                            <li><%= item.product_name %> (x<%= item.quantity %>)</li>
                        <% }) %>
                        </ul>
                    </td>

                    <td>
                        <% if (order.status !== 'completed') { %>
                            <form action="/order/list/<%= order.id %>/complete" method="POST">
                                <button type="submit" class="btn-complete">Mark as Completed</button>
                            </form>
                        <% } else { %>
                            <span class="completed-label">Completed</span>
                        <% } %>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<%- include('../../partials/footer') %>
