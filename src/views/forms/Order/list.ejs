<%- include('../../partials/header') %>
<script>
    function toggleOrder(id) {
        const row = document.getElementById('order-items-' + id);
        if (row.style.display === "none" || row.style.display === "") {
            row.style.display = "table-row";
        } else {
            row.style.display = "none";
        }
    }
</script>

<div class="container">
    <h1>All Orders</h1>

    <% 
        const pending = orders.filter(o => o.status === 'pending');
        const past = orders.filter(o => o.status !== 'pending');
    %>

    <h2>Current Orders</h2>
    <% if (pending.length === 0) { %>
        <p>No pending orders.</p>
    <% } else { %>
        <table>
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Email</th>
                    <th>Address</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Items</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                <% pending.forEach(order => { %>
                    <tr>
                        <td><%= order.id %></td>
                        <td><%= formatDateTime(order.created_at) %></td>
                        
                        <td><%= order.first_name %> <%= order.last_name %></td>
                        <td><%= order.email %></td>
                        
                        <td>
                            <%= order.address %><br>
                            <%= order.city %>, <%= order.state %> <%= order.zip %><br>
                            <%= order.country %>
                        </td>

                        <td>$<%= order.total %></td>
                        <td><%= order.status %></td>

                        <td>
                            <span 
                                class="toggle-btn" 
                                style="cursor:pointer; color:blue; text-decoration:underline;"
                                onclick="toggleOrder('<%= order.id %>')">
                                Show Items
                            </span>
                        </td>

                        <td>
                            <% if (order.status !== 'completed') { %>
                                <form action="/order/list/<%= order.id %>/complete" method="POST">
                                    <button type="submit" class="btn-complete">Mark as Completed</button>
                                </form>
                            <% } else { %>
                                <span class="completed-label">Completed</span>
                            <% } %>
                        </td>
                    </tr>
                    <!-- DROPDOWN ROW -->
                    <tr id="order-items-<%= order.id %>" style="display:none;">
                        <td colspan="10">

                            <% if (order.items.length === 0) { %>
                                <p>No items found for this order.</p>
                            <% } else { %>
                                <% order.items.forEach(item => { %>
                                    <div style="display:flex; align-items:center; margin-bottom:10px;">
                                        <img 
                                            src="<%= item.product_image %>"
                                            alt="<%= item.product_name %>"
                                            style="width:100px; height:100px; object-fit:cover; margin-right:10px;"
                                        >

                                        <strong><%= item.product_name %></strong> — $<%= item.price_each %>
                                    </div>
                                <% }) %>
                            <% } %>

                        </td>
                    </tr>

                <% }) %>
            </tbody>
        </table>
    <% } %>

        <h2>Completed Orders</h2>
    <table>
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Date</th>
                <th>Customer</th>
                <th>Email</th>
                <th>Address</th>
                <th>Total</th>
                <th>Status</th>
                <th>Items</th>
                <th>Actions</th>
                <th>Date Completed</th>
            </tr>
        </thead>

        <tbody>
            <% past.forEach(order => { %>
                <tr>
                    <td><%= order.id %></td>
                    <td><%= formatDateTime(order.created_at) %></td>
                    
                    <td><%= order.first_name %> <%= order.last_name %></td>
                    <td><%= order.email %></td>
                    
                    <td>
                        <%= order.address %><br>
                        <%= order.city %>, <%= order.state %> <%= order.zip %><br>
                        <%= order.country %>
                    </td>

                    <td>$<%= order.total %></td>
                    <td><%= order.status %></td>

                    <td>
                        <span 
                            class="toggle-btn" 
                            style="cursor:pointer; color:blue; text-decoration:underline;"
                            onclick="toggleOrder('<%= order.id %>')">
                            Show Items
                        </span>
                    </td>

                    <td>
                        <% if (order.status !== 'completed') { %>
                            <form action="/order/list/<%= order.id %>/complete" method="POST">
                                <button type="submit" class="btn-complete">Mark as Completed</button>
                            </form>
                        <% } else { %>
                            <span class="completed-label">Completed</span>
                        <% } %>
                    </td>
                    <td><%= order.completed_at ? formatDateTime(order.completed_at) : '' %></td>
                </tr>
                <tr id="order-items-<%= order.id %>" style="display:none;">
                    <td colspan="10">

                        <% if (order.items.length === 0) { %>
                            <p>No items found for this order.</p>
                        <% } else { %>
                            <% order.items.forEach(item => { %>
                                <div style="display:flex; align-items:center; margin-bottom:10px;">
                                    <img 
                                        src="<%= item.product_image %>"
                                        alt="<%= item.product_name %>"
                                        style="width:100px; height:100px; object-fit:cover; margin-right:10px;"
                                    >

                                    <strong><%= item.product_name %></strong> — $<%= item.price_each %>
                                </div>
                            <% }) %>
                        <% } %>

                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>

</div>

<%- include('../../partials/footer') %>
