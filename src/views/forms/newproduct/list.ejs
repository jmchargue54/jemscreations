<%- include('../../partials/header') %>
<div class="productList">
    <h1><%= title %></h1>
    <a href="/createProduct">← Create New Product</a>
    <div class="sort-options">
        <span>Sort by:</span>
        <a href="/products?sortBy=priceAsc" class="<% currentSort === 'priceAsc' ? 'active' : '' %>">Price Ascending</a>
        <a href="/products?sortBy=priceDesc" class="<% currentSort === 'priceDesc' ? 'active' : '' %>">Price Descending</a>
        <a href="/products?sortBy=nameAsc" class="<% currentSort === 'nameAsc' ? 'active' : '' %>">Name Ascending</a>
        <a href="/products?sortBy=nameDesc" class="<% currentSort === 'nameDesc' ? 'active' : '' %>">Name Descending</a>
    </div>
    <div class="filter-options">
        <span>Filter by:</span>
        <form method="GET" action="/products" class="filter-form">
            <label>
                <input type="checkbox" name="tag" value="necklace"
                <%= currentTags.includes('necklace') ? 'checked' : '' %> >
                Necklaces
            </label>

            <label>
                <input type="checkbox" name="tag" value="earrings"
                <%= currentTags.includes('earrings') ? 'checked' : '' %> >
                Earrings
            </label>

            <label>
                <input type="checkbox" name="tag" value="bracelet"
                <%= currentTags.includes('bracelet') ? 'checked' : '' %> >
                Bracelets
            </label>

            <label>
                <input type="checkbox" name="tag" value="ring"
                <%= currentTags.includes('ring') ? 'checked' : '' %> >
                Rings
            </label>

            <label>
                <input type="checkbox" name="tag" value="other"
                <%= currentTags.includes('other') ? 'checked' : '' %> >
                Other
            </label>

            <button type="submit">Apply Filters</button>
        </form>
    </div>
    <% if (products && products.length > 0) {%>
        <div class="productsContainer">
            <% products.forEach(product => { %>
                <div class="productItem">
                    <img src="<%= product.image %>" alt="<%= product.name %>">
                    <h2><%= product.name %></h2>
                    <p><%= product.description %></p>
                    <p class="price">$<%= product.price %></p>
                    <% if (user && user.role_name === 'admin') { %>
                        <div class="productActions">
                            <a href="/createproduct/list/<%= product.id %>/edit">Edit</a>
                            <form method="POST" action="/createproduct/list/<%= product.id %>/delete" style="display: inline;">
                                <button type="submit" onclick="return confirm('Delete this product?')">
                                    Delete
                                </button>
                            </form>
                        </div>
                    <% } %>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <p class="no-products">No products available.</p>
    <% } %>
</div>

<%- include('../../partials/footer') %>