<%- include('../../partials/header') %>
<h1>Edit Product</h1>
<form action="/createProduct/list/<%= product.id %>/edit" method="POST" enctype="multipart/form-data" class="product-form">

    <div>
        <label for="image">Product Image:</label>
        <% if (product.image) { %>
            <img src="<%= product.image %>" alt="Current Product Image" style="width: 150px">
            <input type="hidden" name="oldImage" value="<%= product.image.replace('/uploads/', '') %>">
        <% } %>

        <input type="file" name="image" id="image" accept="image/*">
    </div>

    <div>
        <label for="name">Product Name:</label>
        <input type="text" name="name" id="name" placeholder="Enter product name" value="<%= product.name %>" required>
    </div>

    <div>
        <label for="description">Description:</label>
        <textarea name="description" id="description" placeholder="Describe your product" required><%= product.description %></textarea>
    </div>

    <div>
        <label for="price">Price (USD):</label>
        <input type="number" name="price" id="price" min="0" step="0.01" placeholder="0.00" value="<%= product.price %>" required>
    </div>

    <div>
        <label for="tag">Category:</label>
        <select name="tag" id="tag" required>
            <option value="">Choose a tag</option>
            <option value="necklace" <%= product.tag === "necklace" ? "selected" : "" %>>Necklace</option>
            <option value="bracelet" <%= product.tag === "bracelet" ? "selected" : "" %>>Bracelet</option>
            <option value="rings" <%= product.tag === "rings" ? "selected" : "" %>>Rings</option>
            <option value="earrings" <%= product.tag === "earrings" ? "selected" : "" %>>Earrings</option>
            <option value="other" <%= product.tag === "other" ? "selected" : "" %>>Other</option>
        </select>
    </div>

    <button type="submit">Update Product</button>
    <a href="/createProduct/list">Cancel</a>

</form>


<%- include('../../partials/footer') %>