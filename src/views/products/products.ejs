<%- include('../partials/header') %>
<%
    function toggleTag(tag) {
        let newTags = [...currentTags];

        if (newTags.includes(tag)) {
            newTags = newTags.filter(t => t !== tag);
        } else {
            newTags.push(tag);
        }

        let qs = newTags.map(t => "tag=" + t).join("&");

        if (currentSort && currentSort !== 'default') {
            qs += (qs ? "&" : "") + "sortBy=" + currentSort;
        }

        return "/products" + (qs ? "?" + qs : "");
    }
%>

<div class="productList">
    <h1><%= title %></h1>
    <div class="sort-options">
        <span>Sort by:</span>
        <a href="/products?sortBy=priceAsc" class="<% currentSort === 'priceAsc' ? 'active' : '' %>">Price Ascending</a>
        <a href="/products?sortBy=priceDesc" class="<% currentSort === 'priceDesc' ? 'active' : '' %>">Price Descending</a>
        <a href="/products?sortBy=nameAsc" class="<% currentSort === 'nameAsc' ? 'active' : '' %>">Name Ascending</a>
        <a href="/products?sortBy=nameDesc" class="<% currentSort === 'nameDesc' ? 'active' : '' %>">Name Descending</a>
        <a href="/products" class="<% currentSort === 'default' ? 'active' : '' %>">Default</a>
    </div>
    <div class="filter-options">
        <span>Filter by:</span>
        <div class="filter-buttons">
            <a href="<%= toggleTag('necklace') %>" 
            class="filterBtn <%= currentTags.includes('necklace') ? 'active' : '' %>">
                Necklaces
            </a>

            <a href="<%= toggleTag('earrings') %>" 
            class="filterBtn <%= currentTags.includes('earrings') ? 'active' : '' %>">
                Earrings
            </a>

            <a href="<%= toggleTag('bracelet') %>" 
            class="filterBtn <%= currentTags.includes('bracelet') ? 'active' : '' %>">
                Bracelets
            </a>

            <a href="<%= toggleTag('ring') %>" 
            class="filterBtn <%= currentTags.includes('ring') ? 'active' : '' %>">
                Rings
            </a>

            <a href="<%= toggleTag('other') %>" 
            class="filterBtn <%= currentTags.includes('other') ? 'active' : '' %>">
                Other
            </a>
        </div>
    </div>
    <div class="productsContainer">
        <% products.forEach(product => { %>
            <div class="productItem">
                <img src="<%= product.image %>" alt="<%= product.name %>">
                <h2><a href="/products/<%= product.id %>"><%= product.name %></a></h2>
                <p><%= product.description %></p>
                <p class="price">$<%= product.price %></p>
                <form action="/cart/add" method="POST">
                    <input type="hidden" name="productId" value="<%= product.id %>">
                    <button type="submit" class="addToCartBtn">Add to Cart</button>
                </form>
            </div>
        <% }) %>
    </div>
</div>

<%- include('../partials/footer') %>